 
/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8E9E 50%, #FFA8B8 100%);
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 44rpx;
  z-index: 1000;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: 20%;
  left: -50rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 150rpx;
  height: 150rpx;
  top: 60%;
  right: -30rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 100rpx;
  height: 100rpx;
  top: 80%;
  left: 20%;
  animation-delay: 4s;
}

/* Logo区域 */
.logo-section {
  padding-top: 200rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-container {
  opacity: 0;
  transform: translateY(50rpx);
  transition: all 0.8s ease;
}

.logo-container.animate {
  opacity: 1;
  transform: translateY(0);
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin: 30rpx 0 16rpx 0;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

/* 登录表单区域 */
.login-form {
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  margin: 0 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(255, 107, 157, 0.3);
  backdrop-filter: blur(10rpx);
}

.login-title {
  text-align: center;
  margin-bottom: 60rpx;
}

.title-main {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.title-sub {
  display: block;
  font-size: 28rpx;
  color: #969799;
}

/* 微信登录 */
.wechat-login-btn {
  width: 100%;
  background: #07c160 !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.3);
}

/* 手机号登录 */
.phone-login {
  width: 100%;
}

.form-group {
  margin-bottom: 40rpx;
}

.phone-input, .code-input {
  background: #f7f8fa !important;
  border-radius: 16rpx !important;
  padding: 20rpx !important;
}

.phone-login-btn {
  width: 100%;
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3);
}

/* 登录方式切换 */
.login-switch {
  text-align: center;
  margin: 40rpx 0;
}

.switch-text {
  font-size: 28rpx;
  color: #FF6B9D;
  border-bottom: 1rpx solid #FF6B9D;
  padding-bottom: 4rpx;
}

/* 用户协议 */
.agreement-section {
  margin: 40rpx 0;
}

.agreement-checkbox {
  justify-content: center;
}

.agreement-text {
  font-size: 24rpx;
  color: #646566;
  line-height: 1.5;
}

.agreement-link {
  color: #FF6B9D;
  border-bottom: 1rpx solid #FF6B9D;
}

/* 其他选项 */
.other-options {
  text-align: center;
  margin-top: 40rpx;
}

.guest-mode {
  font-size: 28rpx;
  color: #969799;
  border-bottom: 1rpx solid #969799;
  padding-bottom: 4rpx;
}

/* 底部装饰 */
.bottom-decoration {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.copyright {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 用户协议弹窗 */
.terms-dialog {
  padding: 40rpx;
  background: white;
  border-radius: 24rpx;
  max-width: 600rpx;
  max-height: 80vh;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.dialog-content {
  max-height: 500rpx;
  margin-bottom: 30rpx;
}

.terms-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #646566;
  white-space: pre-line;
}

.dialog-footer .van-button {
  width: 100%;
}

/* 动画效果 */
@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-20rpx) rotate(180deg);
  }
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .login-form {
    margin: 0 30rpx;
    padding: 50rpx 30rpx;
  }
  
  .logo-section {
    padding-top: 160rpx;
  }
  
  .app-name {
    font-size: 42rpx;
  }
}

/* 组件样式覆盖 */
.van-button--primary {
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
}

.van-field__input {
  text-align: center !important;
}

.van-checkbox__icon {
  border-color: #FF6B9D !important;
}

.van-checkbox__icon--checked {
  background-color: #FF6B9D !important;
  border-color: #FF6B9D !important;
}

/* 毛玻璃效果 */
@supports (backdrop-filter: blur(10rpx)) {
  .login-form {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10rpx);
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .login-form {
    background: rgba(40, 40, 40, 0.95);
  }
  
  .title-main {
    color: #ffffff;
  }
  
  .title-sub {
    color: #cccccc;
  }
}