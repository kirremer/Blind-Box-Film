/* pages/unbox/unbox.wxss */
.unbox-container {
  min-height: 100vh;
  background: radial-gradient(circle at 50% 0%, #2b32b2 0%, #1488cc 100%); /* Fallback */
  background: radial-gradient(circle at 50% 30%, #4facfe 0%, #00f2fe 100%); /* Lighter fallback */
  background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%); /* Deep Night Sky */
  position: relative;
  overflow: hidden;
  color: white;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: background 0.3s ease;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 44px;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* 背景粒子 */
.particle-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.particle {
  position: absolute;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.8);
  animation: particleFloat 4s infinite ease-in-out;
}

@keyframes particleFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.4; }
  50% { transform: translateY(-40rpx) scale(1.2); opacity: 0.8; }
}

/* 开箱准备状态 */
.ready-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 200rpx 60rpx 120rpx;
}

.box-preview {
  text-align: center;
  margin-bottom: 120rpx;
  position: relative;
}

.box-container {
  position: relative;
  margin-bottom: 60rpx;
  z-index: 2;
}

.box-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.4) 0%, transparent 70%);
  filter: blur(20rpx);
  animation: glowPulse 3s infinite ease-in-out;
  z-index: -1;
}

@keyframes glowPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
}

.box-info {
  position: relative;
  z-index: 2;
}

.box-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  background: linear-gradient(to right, #fff, #ffd1ff);
  -webkit-background-clip: text;
  color: transparent;
}

.box-subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 32rpx;
}

.box-tip {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

.start-btn {
  width: 480rpx;
  height: 100rpx !important;
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
  box-shadow: 0 0 40rpx rgba(255, 107, 157, 0.6) !important;
  font-size: 36rpx !important;
  font-weight: 600 !important;
  letter-spacing: 4rpx;
}

/* 开箱进行中 */
.opening-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 200rpx 60rpx 120rpx;
}

.opening-box {
  position: relative;
  margin-bottom: 80rpx;
}

.opening-effects {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.ripple {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.3);
  animation: rippleExpand 2s infinite cubic-bezier(0, 0.2, 0.8, 1);
}

.ripple-1 { width: 200rpx; height: 200rpx; margin: -100rpx 0 0 -100rpx; animation-delay: 0s; }
.ripple-2 { width: 400rpx; height: 400rpx; margin: -200rpx 0 0 -200rpx; animation-delay: 0.6s; }
.ripple-3 { width: 600rpx; height: 600rpx; margin: -300rpx 0 0 -300rpx; animation-delay: 1.2s; }

@keyframes rippleExpand {
  0% { transform: scale(0); opacity: 0.8; border-width: 4rpx; }
  100% { transform: scale(1); opacity: 0; border-width: 0; }
}

.opening-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

/* 开箱结果展示 */
.result-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 180rpx 40rpx 120rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.result-progress {
  display: inline-block;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.result-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.result-card {
  position: relative;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 80rpx;
  width: 100%;
  box-sizing: border-box;
}

.rarity-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  z-index: -1;
  opacity: 0.6;
  filter: blur(40rpx);
}

.result-image {
  position: relative;
  margin-bottom: 40rpx;
}

.new-badge {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
  transform: rotate(15deg);
}

.result-info {
  color: white;
}

.result-name {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
}

.result-rarity {
  margin-bottom: 24rpx;
}

.result-series {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24rpx;
}

.result-description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.continue-btn {
  width: 480rpx;
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
  box-shadow: 0 0 40rpx rgba(255, 107, 157, 0.4) !important;
}

/* 开箱完成汇总 */
.summary-container {
  padding: 180rpx 40rpx 120rpx;
  min-height: 100vh;
}

.summary-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.summary-title {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  background: linear-gradient(to right, #fff, #ffd1ff);
  -webkit-background-clip: text;
  color: transparent;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.preview-list {
  display: flex;
  gap: 24rpx;
  padding: 0 10rpx;
}

.preview-item {
  position: relative;
  text-align: center;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.1);
  padding: 10rpx;
  border-radius: 16rpx;
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 60rpx;
}

.action-btn {
  background: rgba(255, 255, 255, 0.1) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.2) !important;
  color: white !important;
  backdrop-filter: blur(10rpx);
}

/* 分享弹窗 */
.share-popup {
  padding: 40rpx;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.share-options {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.share-item text {
  font-size: 24rpx;
  color: var(--text-secondary);
}