/* pages/unbox/unbox.wxss */
.unbox-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.9), rgba(255, 142, 158, 0.9));
  backdrop-filter: blur(10rpx);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  height: 44px;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

/* 背景粒子 */
.particle-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.particle {
  position: absolute;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: particleFloat 3s infinite ease-in-out;
}

@keyframes particleFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(180deg); }
}

/* 开箱准备状态 */
.ready-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 200rpx 60rpx 120rpx;
}

.box-preview {
  text-align: center;
  margin-bottom: 120rpx;
}

.box-container {
  position: relative;
  margin-bottom: 60rpx;
}

.box-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 2s infinite ease-in-out;
}

@keyframes glowPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.8; }
}

.box-info {
  color: white;
}

.box-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.box-subtitle {
  display: block;
  font-size: 32rpx;
  opacity: 0.8;
  margin-bottom: 32rpx;
}

.box-tip {
  display: block;
  font-size: 26rpx;
  opacity: 0.6;
}

.start-btn {
  width: 400rpx;
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 157, 0.4);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 开箱进行中 */
.opening-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 200rpx 60rpx 120rpx;
}

.opening-box {
  position: relative;
  margin-bottom: 80rpx;
}

.opening-effects {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.ripple {
  position: absolute;
  border: 4rpx solid rgba(255, 107, 157, 0.6);
  border-radius: 50%;
  animation: rippleExpand 1.5s infinite ease-out;
}

.ripple-1 {
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  animation-delay: 0s;
}

.ripple-2 {
  width: 300rpx;
  height: 300rpx;
  margin: -150rpx 0 0 -150rpx;
  animation-delay: 0.5s;
}

.ripple-3 {
  width: 400rpx;
  height: 400rpx;
  margin: -200rpx 0 0 -200rpx;
  animation-delay: 1s;
}

@keyframes rippleExpand {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

.opening-text {
  text-align: center;
  color: white;
}

.opening-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.opening-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
}

/* 开箱结果展示 */
.result-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 200rpx 60rpx 120rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
}

.result-progress {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.result-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.result-card {
  position: relative;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 80rpx;
  backdrop-filter: blur(10rpx);
}

.rarity-glow {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 40rpx;
  pointer-events: none;
}

.result-image {
  position: relative;
  margin-bottom: 40rpx;
}

.new-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
}

.result-info {
  color: #323233;
}

.result-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.result-rarity {
  margin-bottom: 20rpx;
}

.result-series {
  font-size: 28rpx;
  color: #969799;
  margin-bottom: 20rpx;
}

.result-description {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.continue-btn {
  width: 400rpx;
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 157, 0.4);
}

/* 开箱完成汇总 */
.summary-container {
  padding: 200rpx 60rpx 120rpx;
  min-height: 100vh;
}

.summary-header {
  text-align: center;
  margin-bottom: 60rpx;
  color: white;
}

.summary-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.8;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  text-align: center;
  color: white;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.result-preview {
  margin-bottom: 60rpx;
}

.preview-scroll {
  white-space: nowrap;
}

.preview-list {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.preview-item {
  position: relative;
  text-align: center;
  flex-shrink: 0;
}

.preview-item .van-tag {
  margin-top: 12rpx;
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 分享弹窗 */
.share-popup {
  padding: 40rpx;
  background: white;
  border-radius: 20rpx 20rpx 0 0;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.share-options {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.share-item text {
  font-size: 24rpx;
  color: #646566;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .ready-container,
  .opening-container,
  .result-container {
    padding-left: 40rpx;
    padding-right: 40rpx;
  }
  
  .result-card {
    padding: 40rpx 30rpx;
  }
  
  .summary-stats {
    padding: 30rpx 15rpx;
  }
}

/* 组件样式覆盖 */
.van-button--primary {
  background: linear-gradient(90deg, #FF6B9D, #FF8E9E) !important;
  border: none !important;
}

.van-tag {
  border: none !important;
}

/* 深色模式下的特殊处理 */
@media (prefers-color-scheme: dark) {
  .result-card {
    background: rgba(40, 40, 40, 0.95);
    color: #ffffff;
  }
  
  .result-info {
    color: #ffffff;
  }
  
  .result-series {
    color: #cccccc;
  }
  
  .result-description {
    color: #aaaaaa;
  }
}