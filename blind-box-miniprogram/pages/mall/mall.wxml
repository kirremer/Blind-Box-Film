 
<!--pages/mall/mall.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索盲盒、相纸..."
      bind:search="onSearch"
      bind:change="onSearchChange"
      shape="round"
      background="#FF6B9D"
    />
  </view>

  <!-- 分类标签 -->
  <view class="tabs-section">
    <van-tabs active="{{ activeTab }}" bind:change="onTabChange" color="#FF6B9D">
      <van-tab title="全部" name="all"></van-tab>
      <van-tab title="盲盒" name="blindbox"></van-tab>
      <van-tab title="相纸" name="photo"></van-tab>
      <van-tab title="热门" name="hot"></van-tab>
    </van-tabs>
  </view>

  <!-- 商品列表 -->
  <view class="products-section">
    <view class="product-grid">
      <view 
        class="product-item" 
        wx:for="{{ productList }}" 
        wx:key="id"
        bind:tap="onProductTap"
        data-product="{{ item }}"
      >
        <view class="product-image">
          <image src="{{ item.cover_image || '/images/default-product.png' }}" mode="aspectFill" />
          <view class="product-tag" wx:if="{{ item.tag }}">{{ item.tag }}</view>
        </view>
        <view class="product-info">
          <view class="product-name">{{ item.name }}</view>
          <view class="product-desc">{{ item.description }}</view>
          <view class="product-price">
            <text class="currency">¥</text>
            <text class="amount">{{ item.price }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{ loadingMore }}">
      <van-loading type="spinner" />
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <van-empty wx:if="{{ !productList.length && !loading }}" description="暂无商品" />
  </view>
</view>