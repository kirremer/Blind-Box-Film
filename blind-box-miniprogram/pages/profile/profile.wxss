 
/* pages/profile/profile.wxss */

.container {
  background: var(--bg-light);
  min-height: 100vh;
}

.user-card {
  background: var(--gradient-pink);
  padding: 40rpx 24rpx;
  color: var(--white);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-section {
  position: relative;
  margin-right: 24rpx;
}

.level-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.login-tip {
  font-size: 28rpx;
  opacity: 0.9;
}

.user-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.quick-actions {
  background: var(--white);
  margin: 24rpx;
  border-radius: var(--border-radius);
  padding: 24rpx 0;
}

.section {
  margin: 24rpx;
}

.order-tabs {
  display: flex;
  justify-content: space-around;
  background: var(--white);
  padding: 32rpx 0;
  border-radius: var(--border-radius);
  margin-top: 16rpx;
}

.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.order-tab text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: var(--primary-color);
  color: var(--white);
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  min-width: 24rpx;
  text-align: center;
}

.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  color: var(--text-secondary) !important;
  border-color: var(--text-light) !important;
}