/* pages/index/index.wxss */

/* 容器与背景 */
.home-container {
  padding: 0;
  position: relative;
  background: var(--bg-page);
  overflow-x: hidden;
}

.bg-decoration {
  position: absolute;
  top: -200rpx;
  left: -100rpx;
  width: 100%;
  height: 800rpx;
  background: radial-gradient(circle at 20% 20%, rgba(255, 143, 177, 0.4) 0%, transparent 60%),
              radial-gradient(circle at 80% 40%, rgba(255, 213, 111, 0.3) 0%, transparent 50%);
  filter: blur(60rpx);
  z-index: 0;
}

/* 头部区域 */
.header-section {
  padding: 100rpx 32rpx 40rpx; /* 增加顶部 padding 适配状态栏 */
  position: relative;
  z-index: 1;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.greeting .text-h2 {
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.greeting .text-body {
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.icon-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.8);
}

.icon-btn .van-icon {
  color: var(--text-primary) !important;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  color: var(--text-light);
  gap: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
}

/* 轮播图 */
.swiper-section {
  margin: 0 32rpx 40rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 1;
}

.banner-swiper {
  height: 320rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-item image {
  width: 100%;
  height: 100%;
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 24rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  color: white;
}

.banner-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: var(--primary-color);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* 公告栏 */
.notice-section {
  margin: 0 32rpx 40rpx;
  position: relative;
  z-index: 1;
}

.glass-notice-bar {
  border-radius: var(--radius-sm);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow-sm);
}

/* 分类导航 */
.category-section {
  display: flex;
  justify-content: space-between;
  padding: 0 48rpx 40rpx;
  position: relative;
  z-index: 1;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.category-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: var(--bg-card);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease;
}

.category-item:active .category-icon-wrapper {
  transform: scale(0.95);
  box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.category-icon-wrapper image {
  width: 56rpx;
  height: 56rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 通用区块 */
.section-container {
  padding: 0 32rpx 40rpx;
  position: relative;
  z-index: 1;
}

.more-link {
  color: var(--text-light);
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.product-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%; /* 1:1 Aspect Ratio */
}

.product-image-wrapper image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.product-info {
  padding: 20rpx;
}

.product-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

/* 盲盒系列 */
.series-scroll {
  display: flex;
  white-space: nowrap;
  padding-bottom: 20rpx; /* Space for shadow */
  margin: 0 -32rpx; /* Negative margin to allow full-width scroll */
  padding: 0 32rpx 20rpx; /* Restore padding */
}

.series-card {
  flex-shrink: 0;
  width: 500rpx;
  height: 280rpx;
  margin-right: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-md);
}

.series-bg {
  width: 100%;
  height: 100%;
}

.series-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.series-tag-pill {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.series-price-tag {
  display: inline-block;
  background: var(--white);
  color: var(--text-primary);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-weight: 700;
  font-size: 32rpx;
  margin-top: 16rpx;
}
