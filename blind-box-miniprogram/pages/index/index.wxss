/* pages/index/index.wxss */

.container {
  padding: 0;
  background: linear-gradient(180deg, #FF6B9D 0%, #FFB347 50%, var(--bg-light) 50%);
  min-height: 100vh;
}

/* 顶部渐变背景区域 */
.header-section {
  padding: 20rpx 24rpx 40rpx;
  position: relative;
  overflow: hidden;
  background: var(--gradient-pink);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-top: 20rpx;
  z-index: 10;
  position: relative;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--white);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  animation: slideUp 0.6s ease-out;
}

.header-actions {
  display: flex;
  gap: 24rpx;
  z-index: 10;
}

.header-actions .van-icon {
  padding: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.header-actions .van-icon:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.25);
}

/* 烟花装饰 */
.fireworks {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.firework {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
  filter: drop-shadow(0 0 10rpx rgba(255, 255, 255, 0.3));
}

.firework-1 {
  top: 60rpx;
  right: 100rpx;
  animation-delay: 0s;
}

.firework-2 {
  top: 200rpx;
  right: 200rpx;
  animation-delay: 1s;
}

.firework-3 {
  top: 120rpx;
  left: 80rpx;
  animation-delay: 2s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.6;
  }
  50% {
    transform: translateY(-20rpx) rotate(180deg);
    opacity: 0.8;
  }
}

/* 公告栏 */
.notice-section {
  margin-bottom: 32rpx;
  z-index: 2;
  position: relative;
  animation: fadeIn 0.8s ease-out 0.2s both;
}

.notice-section .van-notice-bar {
  border-radius: var(--border-radius);
  backdrop-filter: blur(10rpx);
}

/* 分类导航 */
.category-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 16rpx;
  z-index: 2;
  position: relative;
  animation: slideUp 0.8s ease-out 0.4s both;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  min-width: 120rpx;
  transition: transform 0.3s ease;
}

.category-item:active {
  transform: scale(0.95);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.category-item:active .category-icon {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.05);
}

.category-icon image {
  width: 48rpx;
  height: 48rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--white);
  text-align: center;
  font-weight: 500;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 推广卡片 */
.promotion-card {
  margin: 24rpx;
  background: var(--gradient-orange);
  border-radius: var(--border-radius-large);
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow);
  animation: slideUp 0.6s ease-out 0.6s both;
}

.promotion-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% {
    transform: rotate(0deg);
    opacity: 0.5;
  }
  50% {
    transform: rotate(180deg);
    opacity: 0.8;
  }
}

.promotion-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 2;
}

.promotion-text {
  flex: 1;
}

.promotion-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--white);
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.promotion-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.promotion-mascot {
  width: 120rpx;
  height: 120rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.promotion-mascot image {
  width: 100%;
  height: 100%;
}

.close-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  color: var(--white);
  opacity: 0.8;
  padding: 8rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
  z-index: 3;
}

.close-btn:active {
  opacity: 1;
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.9);
}

/* 区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx 24rpx;
  animation: fadeIn 0.6s ease-out;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.section-title .van-icon {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.more-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--text-light);
  transition: color 0.3s ease;
}

.more-link:active {
  color: var(--primary-color);
}

/* 无限宝藏区域 */
.treasure-section {
  background: var(--bg-light);
  animation: fadeIn 0.8s ease-out 0.8s both;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 24rpx 32rpx;
}

.product-item {
  background: var(--white);
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-light);
  transition: all 0.3s ease;
  animation: scaleIn 0.5s ease-out;
}

.product-item:nth-child(1) { animation-delay: 0.1s; }
.product-item:nth-child(2) { animation-delay: 0.2s; }
.product-item:nth-child(3) { animation-delay: 0.3s; }
.product-item:nth-child(4) { animation-delay: 0.4s; }
.product-item:nth-child(5) { animation-delay: 0.5s; }
.product-item:nth-child(6) { animation-delay: 0.6s; }

.product-item:active {
  transform: scale(0.95);
  box-shadow: var(--shadow);
}

.product-image {
  position: relative;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.product-image image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.product-item:active .product-image image {
  transform: scale(1.05);
}

.product-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: var(--primary-color);
  color: var(--white);
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.3);
  animation: glow 2s ease-in-out infinite alternate;
}

@keyframes glow {
  from {
    box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.3);
  }
  to {
    box-shadow: 0 2rpx 12rpx rgba(255, 107, 157, 0.5);
  }
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: var(--primary-color);
  font-weight: bold;
}

.currency {
  font-size: 24rpx;
}

.amount {
  font-size: 32rpx;
}

/* 轮播区域 */
.swiper-section {
  margin: 32rpx 24rpx;
  animation: fadeIn 0.8s ease-out 1s both;
}

.banner-item {
  position: relative;
  height: 300rpx;
  border-radius: var(--border-radius-large);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.banner-item image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.banner-item:active image {
  transform: scale(1.02);
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
  padding: 40rpx 32rpx 32rpx;
  color: var(--white);
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 盲盒系列区域 */
.series-section {
  background: var(--bg-light);
  animation: fadeIn 0.8s ease-out 1.2s both;
}

.series-scroll {
  white-space: nowrap;
}

.series-list {
  display: flex;
  gap: 24rpx;
  padding: 0 24rpx 32rpx;
}

.series-item {
  flex-shrink: 0;
  width: 320rpx;
  background: var(--white);
  border-radius: var(--border-radius-large);
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
  animation: slideUp 0.6s ease-out;
}

.series-item:nth-child(1) { animation-delay: 0.2s; }
.series-item:nth-child(2) { animation-delay: 0.4s; }
.series-item:nth-child(3) { animation-delay: 0.6s; }

.series-item:active {
  transform: scale(0.98) translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.series-image {
  position: relative;
  width: 100%;
  height: 240rpx;
  overflow: hidden;
}

.series-image image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.series-item:active .series-image image {
  transform: scale(1.05);
}

.series-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: var(--primary-color);
  color: var(--white);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.3);
  backdrop-filter: blur(10rpx);
}

.series-info {
  padding: 24rpx;
}

.series-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.series-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.series-price {
  display: flex;
  align-items: baseline;
  color: var(--primary-color);
  font-weight: bold;
}

.series-price .currency {
  font-size: 28rpx;
}

.series-price .amount {
  font-size: 40rpx;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12rpx;
  }
  
  .series-item {
    width: 280rpx;
  }
  
  .category-grid {
    gap: 12rpx;
  }
  
  .category-item {
    min-width: 100rpx;
  }
  
  .category-icon {
    width: 70rpx;
    height: 70rpx;
  }
  
  .category-icon image {
    width: 42rpx;
    height: 42rpx;
  }
}

@media (max-width: 320px) {
  .product-grid {
    grid-template-columns: 1fr 1fr;
  }
  
  .series-item {
    width: 260rpx;
  }
  
  .promotion-card {
    margin: 16rpx;
    padding: 24rpx;
  }
  
  .title {
    font-size: 38rpx;
  }
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--text-light);
  animation: fadeIn 0.6s ease-out;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 28rpx;
  line-height: 1.5;
}

/* 底部安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-light);
}

/* 特殊效果增强 */
.product-item:hover,
.series-item:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 性能优化 */
.product-image image,
.series-image image,
.banner-item image {
  will-change: transform;
}

.product-item,
.series-item,
.category-item {
  will-change: transform;
}

/* 无障碍支持 */
.category-item:focus,
.product-item:focus,
.series-item:focus {
  outline: 2rpx solid var(--primary-color);
  outline-offset: 4rpx;
}

/* 高对比度模式支持 */
@media (prefers-contrast: high) {
  .category-icon {
    border: 2rpx solid rgba(255, 255, 255, 0.8);
  }
  
  .product-badge,
  .series-tag {
    border: 1rpx solid rgba(255, 255, 255, 0.3);
  }
}