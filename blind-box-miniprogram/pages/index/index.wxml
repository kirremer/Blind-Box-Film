<!--pages/index/index.wxml-->
<view class="container home-container">
  <!-- 顶部背景装饰 -->
  <view class="bg-decoration"></view>

  <!-- 头部区域 -->
  <view class="header-section animate-fade-in">
    <view class="header-top">
      <view class="greeting">
        <view class="text-h2 text-white">盲盒盒机</view>
        <view class="text-body text-white opacity-80">探索未知的惊喜</view>
      </view>
      <view class="header-actions">
        <view class="icon-btn glass-effect" bind:tap="onScanClick">
          <van-icon name="scan" size="20" color="white" />
        </view>
        <view class="icon-btn glass-effect" bind:tap="onMoreClick">
          <van-icon name="ellipsis" size="20" color="white" />
        </view>
      </view>
    </view>

    <!-- 搜索栏 (伪) -->
    <view class="search-bar glass-effect animate-fade-in" style="animation-delay: 0.1s">
      <van-icon name="search" color="white" size="18" />
      <text class="search-placeholder">搜索盲盒系列...</text>
    </view>
  </view>

  <!-- 轮播图区域 -->
  <view class="swiper-section animate-fade-in" style="animation-delay: 0.2s" wx:if="{{banners.length > 0}}">
    <swiper 
      autoplay="{{true}}" 
      interval="4000" 
      circular="{{true}}"
      previous-margin="0"
      next-margin="0"
      class="banner-swiper">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item" bind:tap="onBannerTap" data-banner="{{item}}">
          <image src="{{item.image}}" mode="aspectFill" />
          <view class="banner-content">
            <view class="banner-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
            <view class="banner-title">{{item.title}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 公告栏 -->
  <view class="notice-section animate-fade-in" style="animation-delay: 0.3s">
    <van-notice-bar
      left-icon="volume-o"
      text="{{noticeText}}"
      background="rgba(255, 255, 255, 0.6)"
      color="#2D3436"
      custom-class="glass-notice-bar"
    />
  </view>

  <!-- 分类导航 -->
  <view class="category-section animate-fade-in" style="animation-delay: 0.4s">
    <view 
      class="category-item" 
      wx:for="{{categories}}" 
      wx:key="id"
      bind:tap="onCategoryTap"
      data-category="{{item}}"
    >
      <view class="category-icon-wrapper">
        <image src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门推荐 (无限宝藏) -->
  <view class="section-container animate-fade-in" style="animation-delay: 0.5s">
    <view class="section-header flex-between mb-3">
      <view class="text-h3">无限宝藏</view>
      <view class="more-link text-caption flex-center" bind:tap="onMoreTreasure">
        更多 <van-icon name="arrow" />
      </view>
    </view>

    <view class="product-grid">
      <view 
        class="product-card" 
        wx:for="{{treasureProducts}}" 
        wx:key="id"
        bind:tap="onProductTap"
        data-product="{{item}}"
      >
        <view class="product-image-wrapper">
          <image src="{{item.cover_image || '/images/default-product.png'}}" mode="aspectFill" />
          <view class="product-tag" wx:if="{{item.badge}}">{{item.badge}}</view>
        </view>
        <view class="product-info">
          <view class="product-title text-body text-bold">{{item.name}}</view>
          <view class="product-price text-primary text-bold">
            <text class="text-xs">¥</text>{{item.price}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 盲盒系列 -->
  <view class="section-container animate-fade-in" style="animation-delay: 0.6s">
    <view class="section-header flex-between mb-3">
      <view class="text-h3">热门系列</view>
      <view class="more-link text-caption flex-center" bind:tap="onMoreSeries">
        更多 <van-icon name="arrow" />
      </view>
    </view>

    <scroll-view class="series-scroll" scroll-x enable-flex>
      <view 
        class="series-card" 
        wx:for="{{blindBoxSeries}}" 
        wx:key="id"
        bind:tap="onSeriesTap"
        data-series="{{item}}"
      >
        <image class="series-bg" src="{{item.cover_image || '/images/default-blindbox.png'}}" mode="aspectFill" />
        <view class="series-overlay">
          <view class="series-tag-pill">{{item.theme}}</view>
          <view class="series-content">
            <view class="text-h3 text-white mb-1">{{item.name}}</view>
            <view class="text-caption text-white opacity-80">{{item.description}}</view>
            <view class="series-price-tag">
              <text class="text-xs">¥</text>{{item.price}}
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <view class="safe-area-bottom"></view>
</view>

<!-- Toast 组件 -->
<van-toast id="van-toast" />
<!-- Dialog 组件 -->
<van-dialog id="van-dialog" />
