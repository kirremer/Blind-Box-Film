 
/* pages/ranking/ranking.wxss */

.container {
  background: var(--bg-light);
  min-height: 100vh;
}

.tabs-section {
  background: var(--white);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.my-rank-section {
  margin: 24rpx;
}

.my-rank-card {
  background: var(--gradient-pink);
  border-radius: var(--border-radius);
  padding: 32rpx;
  display: flex;
  align-items: center;
  color: var(--white);
}

.rank-info {
  text-align: center;
  margin-right: 32rpx;
}

.rank-number {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.rank-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.user-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.user-details {
  margin-left: 16rpx;
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.score {
  font-size: 28rpx;
  opacity: 0.9;
}

.rank-trend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-up {
  color: #07c160;
}

.trend-down {
  color: #ee0a24;
}

.ranking-list {
  margin: 24rpx;
}

.top-three {
  display: flex;
  justify-content: space-around;
  background: var(--white);
  border-radius: var(--border-radius);
  padding: 40rpx 20rpx;
  margin-bottom: 24rpx;
}

.top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.medal {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
}

.medal image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 16rpx 0 8rpx;
  text-align: center;
}

.user-score {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.other-ranks {
  background: var(--white);
  border-radius: var(--border-radius);
  overflow: hidden;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--bg-light);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-right: 24rpx;
}

.rank-item .user-info {
  flex: 1;
  margin-left: 16rpx;
  color: var(--text-primary);
}

.rank-item .nickname {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.user-level {
  font-size: 20rpx;
  color: var(--text-light);
  background: var(--bg-light);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.rank-item .score {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-right: 16rpx;
}

.rank-change {
  width: 40rpx;
  text-align: center;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
}