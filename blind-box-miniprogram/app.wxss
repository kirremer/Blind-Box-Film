/**app.wxss**/
@import './lib/vant-weapp/common/index.wxss';

/* 全局变量 */
:root {
  --primary-color: #FF6B9D;
  --secondary-color: #FFB347;
  --gradient-pink: linear-gradient(135deg, #FF6B9D 0%, #FFB347 100%);
  --gradient-orange: linear-gradient(135deg, #FFB347 0%, #FF8A80 100%);
  --gradient-blue: linear-gradient(135deg, #64B5F6 0%, #42A5F5 100%);
  --gradient-purple: linear-gradient(135deg, #BA68C8 0%, #9C27B0 100%);
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --bg-light: #f8f8f8;
  --white: #ffffff;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
  --shadow-light: 0 2px 8px rgba(0, 0, 0, 0.08);
  --border-radius: 16rpx;
  --border-radius-large: 24rpx;
}

/* 全局重置 */
page {
  background-color: var(--bg-light);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
  line-height: 1.6;
}

/* 通用类 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 渐变背景 */
.gradient-bg {
  background: var(--gradient-pink);
  color: var(--white);
}

.gradient-bg-orange {
  background: var(--gradient-orange);
  color: var(--white);
}

.gradient-bg-blue {
  background: var(--gradient-blue);
  color: var(--white);
}

.gradient-bg-purple {
  background: var(--gradient-purple);
  color: var(--white);
}

/* 卡片样式 */
.card {
  background: var(--white);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-light);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-large {
  background: var(--white);
  border-radius: var(--border-radius-large);
  box-shadow: var(--shadow);
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.card-gradient {
  background: var(--gradient-pink);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: var(--white);
}

/* 按钮样式 */
.btn-primary {
  background: var(--gradient-pink) !important;
  border: none !important;
  border-radius: 48rpx !important;
  color: var(--white) !important;
  font-weight: 600 !important;
  box-shadow: var(--shadow) !important;
}

.btn-secondary {
  background: var(--white) !important;
  border: 2rpx solid var(--primary-color) !important;
  border-radius: 48rpx !important;
  color: var(--primary-color) !important;
  font-weight: 600 !important;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.2) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.3) !important;
  border-radius: 48rpx !important;
  color: var(--white) !important;
  font-weight: 600 !important;
}

/* 文本样式 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-light {
  color: var(--text-light);
}

.text-white {
  color: var(--white);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

.text-large {
  font-size: 36rpx;
}

.text-medium {
  font-size: 32rpx;
}

.text-small {
  font-size: 28rpx;
}

.text-xs {
  font-size: 24rpx;
}

/* 布局样式 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-around {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距样式 */
.m-0 { margin: 0; }
.m-1 { margin: 8rpx; }
.m-2 { margin: 16rpx; }
.m-3 { margin: 24rpx; }
.m-4 { margin: 32rpx; }

.mt-0 { margin-top: 0; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }

.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.p-0 { padding: 0; }
.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }

.pt-0 { padding-top: 0; }
.pt-1 { padding-top: 8rpx; }
.pt-2 { padding-top: 16rpx; }
.pt-3 { padding-top: 24rpx; }
.pt-4 { padding-top: 32rpx; }

.pb-0 { padding-bottom: 0; }
.pb-1 { padding-bottom: 8rpx; }
.pb-2 { padding-bottom: 16rpx; }
.pb-3 { padding-bottom: 24rpx; }
.pb-4 { padding-bottom: 32rpx; }

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

.bounce-in {
  animation: bounceIn 0.5s ease-out;
}

.scale-in {
  animation: scaleIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes bounceIn {
  0% {
    transform: scale(0.3);
    opacity: 0;
  }
  50% {
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* 特殊效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.glow-effect {
  box-shadow: 0 0 20rpx rgba(255, 107, 157, 0.3);
}

.hover-scale {
  transition: transform 0.2s ease;
}

.hover-scale:active {
  transform: scale(0.95);
}

/* 状态样式 */
.success {
  color: #4CAF50;
}

.warning {
  color: #FF9800;
}

.error {
  color: #F44336;
}

.info {
  color: #2196F3;
}

/* 遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--text-light);
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-light);
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}
