/**app.wxss**/
@import './lib/vant-weapp/common/index.wxss';

/* 全局变量 - Premium Design System */
:root {
  /* 主色调 - 柔和粉与暖琥珀 */
  --primary-color: #FF8FB1; /* 更柔和的粉色 */
  --primary-dark: #FF5C8D;
  --secondary-color: #FFD56F; /* 暖琥珀色 */
  
  /* 渐变色 - Mesh Gradient 风格 */
  --gradient-primary: linear-gradient(135deg, #FF8FB1 0%, #FFD56F 100%);
  --gradient-warm: linear-gradient(135deg, #FFD56F 0%, #FFAB91 100%);
  --gradient-cool: linear-gradient(135deg, #81D4FA 0%, #4FC3F7 100%);
  --gradient-night: linear-gradient(135deg, #2D3436 0%, #636E72 100%);
  
  /* 文本颜色 */
  --text-primary: #2D3436; /* 深炭灰，比纯黑更高级 */
  --text-secondary: #636E72;
  --text-light: #B2BEC3;
  --text-white: #FFFFFF;
  
  /* 背景色 */
  --bg-page: #F7F9FC; /* 极淡的冷灰背景 */
  --bg-card: #FFFFFF;
  --bg-glass: rgba(255, 255, 255, 0.85); /* 毛玻璃背景 */
  
  /* 阴影 - 弥散投影 */
  --shadow-sm: 0 2rpx 8rpx rgba(45, 52, 54, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(45, 52, 54, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(45, 52, 54, 0.12);
  --shadow-primary: 0 8rpx 24rpx rgba(255, 143, 177, 0.3);
  
  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;
}

/* 全局重置 */
page {
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  line-height: 1.5;
  color: var(--text-primary);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 卡片样式 - Glassmorphism & Clean */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
}

.card-glass {
  background: var(--bg-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card:active, .card-glass:active {
  transform: scale(0.98);
}

/* 按钮样式 */
.btn-primary {
  background: var(--gradient-primary) !important;
  border: none !important;
  border-radius: var(--radius-full) !important;
  color: var(--text-white) !important;
  font-weight: 600 !important;
  box-shadow: var(--shadow-primary) !important;
}

.btn-secondary {
  background: var(--bg-card) !important;
  border: 2rpx solid var(--primary-color) !important;
  border-radius: var(--radius-full) !important;
  color: var(--primary-color) !important;
  font-weight: 600 !important;
}

/* 文本工具类 */
.text-h1 { font-size: 48rpx; font-weight: 700; line-height: 1.2; }
.text-h2 { font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.text-h3 { font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.text-body { font-size: 28rpx; font-weight: 400; line-height: 1.5; }
.text-caption { font-size: 24rpx; font-weight: 400; color: var(--text-secondary); }

.text-gradient {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  color: transparent;
  display: inline-block;
}

/* 布局工具类 */
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-column { display: flex; flex-direction: column; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 32rpx; }

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* 骨架屏加载动画 */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(90deg, #f0f2f5 25%, #e6e8eb 37%, #f0f2f5 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}
